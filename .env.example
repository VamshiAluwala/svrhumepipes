# ═══════════════════════════════════════════════════════════════
#  SVR HUME PIPES: Contact form delivery config (TEMPLATE)
# ═══════════════════════════════════════════════════════════════
# ⚠️  DO NOT put real API keys in this file: it is committed to
#     git and visible publicly. Real values belong in .env.local
#     (which is gitignored).
#
# 1) cp .env.example .env.local
# 2) fill in .env.local with real values
# 3) restart `npm run dev`
# Any channel with missing config is silently skipped, so you can
# enable them one at a time.
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# 1) EMAIL: via Resend (https://resend.com)
# ─────────────────────────────────────────────────────────────
# Sign up (no credit card), create an API key, paste it in .env.local.
# LEAD_EMAIL_TO = comma-separated list of recipient inboxes.
# LEAD_EMAIL_FROM: keep the default OR verify svrhumepipes.com
#   in Resend and use e.g. "SVR Leads <leads@svrhumepipes.com>"
# Free tier: 3,000 emails/month.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# ─────────────────────────────────────────────────────────────
# 2) GOOGLE SHEET: via Apps Script webhook
# ─────────────────────────────────────────────────────────────
# See SETUP.md for step-by-step Sheet + Apps Script setup.
# Paste the deployed Web-App URL (ends with /exec).
GOOGLE_SHEET_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────
# 3) WHATSAPP: via CallMeBot (https://www.callmebot.com)
# ─────────────────────────────────────────────────────────────
# 1. Save +34 644 51 95 23 to your phone contacts as "CallMeBot"
# 2. Send from your WhatsApp: I allow callmebot to send me messages
# 3. You get back an API key: paste it in .env.local.
# 4. Set CALLMEBOT_PHONE to your number in international format
#    (digits only, no + or space).
# Free for personal use.
CALLMEBOT_PHONE= 
CALLMEBOT_API_KEY=

# Google Search Console HTML-tag verification "content" value. Optional: leave empty when verifying with the HTML file in public/
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# SEO: extra background keywords for meta tags (comma-separated, optional)
SEO_KEYWORDS=
